generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String     @id @default(uuid())
  email         String     @unique
  passwordHash  String
  role          Role
  status        String     @default("ACTIVE")
  restaurantId  String
  branchId      String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  auditLogs     AuditLog[]
  ordersCreated Order[]    @relation("OrderCreator")
  ordersServed  Order[]    @relation("OrderWaiter")
  branch        Branch?    @relation(fields: [branchId], references: [id])
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}


model Restaurant {
  id         String         @id @default(uuid())
  name       String
  ownerId    String?
  settings   Json?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  branches   Branch[]
  categories MenuCategory[]
  users      User[]
}

model Branch {
  id           String          @id @default(uuid())
  name         String
  address      String?
  phone        String?
  restaurantId String
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  restaurant   Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  inventory    InventoryItem[]
  orders       Order[]
  tables       Table[]
  users        User[]
}

model Table {
  id        String      @id @default(uuid())
  number    String
  capacity  Int
  status    TableStatus @default(AVAILABLE)
  branchId  String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  orders    Order[]
  branch    Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
}

model MenuCategory {
  id           String     @id @default(uuid())
  name         String
  restaurantId String
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items        MenuItem[]

  @@unique([name, restaurantId])
}

model MenuItem {
  id            String               @id @default(uuid())
  name          String
  description   String?
  price         Float
  categoryId    String
  isActive      Boolean              @default(true)
  isSoftDeleted Boolean              @default(false)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  category      MenuCategory         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  ingredients   MenuItemIngredient[]
  orderItems    OrderItem[]
}

model InventoryItem {
  id           String               @id @default(uuid())
  name         String
  quantity     Float                @default(0)
  minThreshold Float                @default(0)
  branchId     String
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  branch       Branch               @relation(fields: [branchId], references: [id], onDelete: Cascade)
  menuItems    MenuItemIngredient[]
}

model MenuItemIngredient {
  id              String        @id @default(uuid())
  menuItemId      String
  inventoryItemId String
  quantityNeeded  Float
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  menuItem        MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, inventoryItemId])
}

model Supplier {
  id          String   @id @default(uuid())
  name        String
  contactInfo String?
  email       String?
  phone       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Order {
  id              String      @id @default(uuid())
  orderNumber     String      @unique
  type            OrderType
  status          OrderStatus @default(PENDING)
  branchId        String
  tableId         String?
  creatorId       String
  waiterId        String?
  customerName    String?
  customerPhone   String?
  deliveryAddress String?
  deliveryFee     Float       @default(0)
  subtotal        Float       @default(0)
  tax             Float       @default(0)
  serviceCharge   Float       @default(0)
  total           Float       @default(0)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  branch          Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  creator         User        @relation("OrderCreator", fields: [creatorId], references: [id])
  table           Table?      @relation(fields: [tableId], references: [id])
  waiter          User?       @relation("OrderWaiter", fields: [waiterId], references: [id])
  items           OrderItem[]
  payments        Payment[]
}

model OrderItem {
  id         String   @id @default(uuid())
  orderId    String
  menuItemId String
  quantity   Int      @default(1)
  price      Float
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Payment {
  id            String        @id @default(uuid())
  orderId       String
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  transactionId String?       @unique
  amount        Float
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  details   String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
}

enum Role {
  OWNER
  MANAGER
  CASHIER
  WAITER
  CHEF
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  CLEANING
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  SERVED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  WALLET
}

enum PaymentStatus {
  PENDING
  COMPLETED
  REFUNDED
}



